    print("  Number of satellites: " + str(len(all_x_vals)))
    print("  KS Statistic: " + str(np.round(overall_stat, 5)))
    print("  p-value: " + str(np.format_float_scientific(overall_p_value, precision=5)))
    results['overall_ks_stat'] = overall_stat
    results['overall_ks_pvalue'] = overall_p_value
    results['all_x_vals'] = all_x_vals
    output_file = os.path.join(output_data_dir, "empirical_satellite_profile.npz")
    np.savez(output_file, **results)
    print("\nAggregated results saved to " + output_file)
