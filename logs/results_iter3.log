    err_rel = (std_delta_xi / np.sqrt(10.0)) / mean_xi_emp_safe
    rel_diff = mean_delta_xi / mean_xi_emp_safe
    ax.errorbar(r_centers_xi, rel_diff, yerr=err_rel, fmt='go-', label='Delta_xi / xi_emp')
