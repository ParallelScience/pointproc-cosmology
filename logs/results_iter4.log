    volume_shell = 4.0 * np.pi * bin_centers_rad**2 * delta_x
    all_rho_emp = []
    gnfw_params_realization = []
    for i in range(10):
        gal_path = os.path.join(input_dir, 'galaxy_catalog_' + str(i).zfill(2) + '.npy')
