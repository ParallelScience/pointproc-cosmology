    emp_arr = np.array(all_xi_emp)
    all_frac_res_xi = np.zeros_like(emp_arr)
    mask_all = np.abs(syn_arr) > 1e-6
    all_frac_res_xi[mask_all] = (emp_arr[mask_all] - syn_arr[mask_all]) / syn_arr[mask_all]
    all_frac_res_xi[~mask_all] = np.nan
