        counts, _ = np.histogram(r_norm, bins=bins_rad)
        rho_emp = counts / (len(r_norm) * volume_shell)
        all_rho_emp.append(rho_emp)
        mask_bin1 = (M_vir_valid > 1e13) & (M_vir_valid < 1e14)
