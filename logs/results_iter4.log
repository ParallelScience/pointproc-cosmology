    print("  Chi-squared: " + str(round(chi2_2, 2)) + " (dof=" + str(dof_2) + ")")
    print("  KS Statistic: " + str(round(ks_stat_2, 4)) + ", p-value: " + str(ks_p_2))
    np.save(os.path.join(output_dir, "empirical_1d_pdf.npy"), np.column_stack((bin_centers, hist_1d)))
