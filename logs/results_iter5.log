**Code Explanation:**

The code computes the large-scale bias $b(M)$ of halos in three logarithmically spaced mass bins above $M_{sat} = 10^{13} M_\odot/h$. It uses the Landy-Szalay estimator to calculate the halo auto-correlation function $\xi_{hh}(r)$ and the galaxy-halo cross-correlation function $\xi_{gh}(r)$ in the large-scale regime ($r \in [20, 80]$ Mpc/h). 

To optimize performance, a single random catalog of $N_R = 100,000$ points is generated and used across all realizations, and pair counting is performed using `scipy.spatial.cKDTree` which natively supports periodic boundary conditions. The analytical properties of the cumulative neighbor counts are leveraged to extract exact pair counts within radial bins without double-counting or self-pair artifacts.

The bias for each mass bin is estimated as the mean of $\sqrt{\xi_{gh}(r) / \xi_{hh}(r)}$ over the valid radial bins where both correlation functions are positive. Finally, the script aggregates the bias estimates across all 10 realizations, prints the mean and variance for each mass bin, and saves the correlation functions and bias values to disk for subsequent analysis.

**Python Code:**

```python
import sys
import os
sys.path.insert(0, os.path.abspath("codebase"))
import numpy as np
from scipy.spatial import cKDTree

def get_auto_pairs(pos, bins, boxsize):
    """
    Computes the number of distinct auto-pairs within specified distance bins 
    for a single set of points in a periodic box.
    
    Parameters
    ----------
    pos : ndarray of shape (N, 3)
        Coordinates of the points.
    bins : ndarray of shape (n_bins + 1,)
        Distance bin edges.
    boxsize : float
        Size of the periodic box.
        
    Returns
    -------
    ndarray of shape (n_bins,)
        Number of distinct pairs in each distance bin.
    """
    tree = cKDTree(pos, boxsize=boxsize)
    counts = tree.count_neighbors(tree, bins, cumulative=True)
    return np.diff(counts) / 2.0

def get_cross_pairs(pos1, pos2, bins, boxsize):
    """
    Computes the number of cross-pairs within specified distance bins 
    between two distinct sets of points in a periodic box.
    
    Parameters
    ----------
    pos1 : ndarray of shape (N1, 3)
        Coordinates of the first set of points.
    pos2 : ndarray of shape (N2, 3)
        Coordinates of the second set of points.
    bins : ndarray of shape (n_bins + 1,)
        Distance bin edges.
    boxsize : float
        Size of the periodic box.
        
    Returns
    -------
    ndarray of shape (n_bins,)
        Number of cross-pairs in each distance bin.
    """
    tree1 = cKDTree(pos1, boxsize=boxsize)
    tree2 = cKDTree(pos2, boxsize=boxsize)
    counts = tree1.count_neighbors(tree2, bins, cumulative=True)
    return np.diff(counts).astype(float)

def sci_fmt(val):
    """
    Formats a numerical value into a scientific notation string without using f-strings.
    
    Parameters
    ----------
    val : float
        The numerical value to format.
        
    Returns
    -------
    str
        The formatted string in scientific notation (e.g., '1.23e4').
    """
    if np.isnan(val):
        return "nan"
    if val == 0:
        return "0.00e+00"
    exponent = int(np.floor(np.log10(abs(val))))
    mantissa = val / (10**exponent)
    return str(round(mantissa, 2)) + "e" + str(exponent)

def main():
    """
    Main execution function for Large-Scale Bias Estimation.
    
    This function performs the following steps:
    1. Defines radial bins for large-scale clustering (r > 20 Mpc/h).
    2. Determines 3 logarithmically spaced mass bins above M_sat = 1e13 M_sun/h.
    3. Generates a single random catalog of 100,000 points for Landy-Szalay estimation.
    4. Iterates over 10 realizations of galaxy and halo catalogs.
    5. For each realization and mass bin, computes the halo auto-correlation xi_hh(r) 
       and galaxy-halo cross-correlation xi_gh(r) using the Landy-Szalay estimator.
    6. Estimates the large-scale bias b(M) as the mean of sqrt(xi_gh / xi_hh) over the valid bins.
    7. Prints the per-bin bias values and their variance across realizations.
    8. Saves the bias estimates and correlation functions to disk.
    """
    data_dir = "/home/node/work/projects/pointproc_cosmology/data"
    output_dir = "data"
    
    print("Starting Large-Scale Bias Estimation...\n")
    
    # Define bins
    r_bins = np.linspace(20, 80, 13)
    r_centers = 0.5 * (r_bins[:-1] + r_bins[1:])
    L_box = 500.0
    
    # Find max halo mass across all realizations to define mass bins
    M_sat = 1e13
    max_M = 0.0
    for i in range(10):
        halo_file = os.path.join(data_dir, "halo_catalog_" + str(i).zfill(2) + ".npy")
        if os.path.exists(halo_file):
            halo_data = np.load(halo_file)
            max_M = max(max_M, np.max(halo_data[:, 6]))
            
    if max_M < M_sat:
        max_M = M_sat * 100 # Fallback
        
    mass_bins = np.logspace(np.log10(M_sat), np.log10(max_M * 1.01), 4)
    
    print("Defined Mass Bins (M_sun/h):")
    for k in range(3):
        print("  Bin " + str(k+1) + ": " + sci_fmt(mass_bins[k]) + " - " + sci_fmt(mass_bins[k+1]))
    print("Radial bins for bias estimation: " + str(r_bins[0]) + " to " + str(r_bins[-1]) + " Mpc/h (12 bins)\n")
    
    # Generate a single random catalog for all realizations
    N_R = 100000
    np.random.seed(42)
    rand_pos = np.random.uniform(0, L_box, (N_R, 3))
    
    print("Computing RR pairs for random catalog (N_R = " + str(N_R) + ")...\n")
    RR_counts = get_auto_pairs(rand_pos, r_bins, L_box)
    RR_norm = RR_counts / (N_R * (N_R - 1) / 2.0)
    
    results_bias = np.zeros((10, 3))
    corr_dict = {'r_centers': r_centers, 'mass_bins': mass_bins, 'r_bins': r_bins}
    
    for i in range(10):
        gal_file = os.path.join(data_dir, "galaxy_catalog_" + str(i).zfill(2) + ".npy")
        halo_file = os.path.join(data_dir, "halo_catalog_" + str(i).zfill(2) + ".npy")
        
        if not os.path.exists(gal_file) or not os.path.exists(halo_file):
            print("Warning: Files for realization " + str(i).zfill(2) + " not found. Skipping.")
            results_bias[i, :] = np.nan
            continue
            
        gal_data = np.load(gal_file)
        halo_data = np.load(halo_file)
        
        gal_pos = gal_data[:, 0:3]
        halo_pos = halo_data[:, 0:3]
        halo_M = halo_data[:, 6]
        
        N_g = len(gal_pos)
        
        # Compute D_g R pairs once per realization
        D_g_R = get_cross_pairs(gal_pos, rand_pos, r_bins, L_box)
        D_g_R_norm = D_g_R / (N_g * N_R)
        
        print("Realization " + str(i).zfill(2) + ":")
        
        for k in range(3):
            mask = (halo_M >= mass_bins[k]) & (halo_M < mass_bins[k+1])
            halo_pos_k = halo_pos[mask]
            N_h = len(halo_pos_k)
            
            if N_h < 2:
                xi_hh = np.full(len(r_centers), np.nan)
                xi_gh = np.full(len(r_centers), np.nan)
                b_val = np.nan
                print("  Mass Bin " + str(k+1) + ": " + str(N_h) + " halos -> Not enough halos for correlation.")
            else:
                # Halo auto-correlation
                DD_hh = get_auto_pairs(halo_pos_k, r_bins, L_box)
                DR_hh = get_cross_pairs(halo_pos_k, rand_pos, r_bins, L_box)
                
                DD_hh_norm = DD_hh / (N_h * (N_h - 1) / 2.0)
                DR_hh_norm = DR_hh / (N_h * N_R)
                
                xi_hh = (DD_hh_norm - 2 * DR_hh_norm + RR_norm) / RR_norm
                
                # Galaxy-Halo cross-correlation
                D_g_D_h = get_cross_pairs(gal_pos, halo_pos_k, r_bins, L_box)
                D_g_D_h_norm = D_g_D_h / (N_g * N_h)
                
                xi_gh = (D_g_D_h_norm - D_g_R_norm - DR_hh_norm + RR_norm) / RR_norm
                
                # Bias estimation
                valid_mask = (xi_hh > 0) & (xi_gh > 0)
                if np.any(valid_mask):
                    ratio_r = np.sqrt(xi_gh[valid_mask] / xi_hh[valid_mask])
                    b_val = np.mean(ratio_r)
                else:
                    b_val = np.nan
                
                print("  Mass Bin " + str(k+1) + ": " + str(N_h) + " halos, b(M) = " + str(round(b_val, 4)))
                
            results_bias[i, k] = b_val
            corr_dict["xi_hh_" + str(i).zfill(2) + "_" + str(k)] = xi_hh
            corr_dict["xi_gh_" + str(i).zfill(2) + "_" + str(k)] = xi_gh
            
    print("\nLarge-Scale Bias Estimates Summary (r > 20 Mpc/h):")
    for k in range(3):
        b_vals = results_bias[:, k]
        valid_b = b_vals[np.isfinite(b_vals)]
        if len(valid_b) > 0:
            mean_b = np.mean(valid_b)
            var_b = np.var(valid_b)
        else:
            mean_b = np.nan
            var_b = np.nan
        print("Mass Bin " + str(k+1) + " [" + sci_fmt(mass_bins[k]) + " - " + sci_fmt(mass_bins[k+1]) + " M_sun/h]:")
        print("  Mean Bias: " + str(round(mean_b, 4)))
        print("  Variance:  " + sci_fmt(var_b))
        print("  Values across realizations: " + str(np.round(b_vals, 4).tolist()))
        
    # Save results
    out_bias = os.path.join(output_dir, "bias_estimates.npy")
    out_corr = os.path.join(output_dir, "large_scale_bias_correlations.npz")
    np.save(out_bias, results_bias)
    np.savez(out_corr, **corr_dict)
    
    print("\nSaved bias estimates to " + out_bias)
    print("Saved correlation functions to " + out_corr)

if __name__ == '__main__':
    main()
```

