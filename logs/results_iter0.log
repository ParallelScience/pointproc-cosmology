**Code Explanation:**

The code computes the two-point correlation function (2PCF) for the 1-halo regime ($r < 5$ Mpc/h) using the Landy-Szalay estimator. To isolate the internal clustering signal, the galaxies are separated into "centrals" and "satellites". We compute two distinct 2PCF components:
1. **Central-Satellite ($\xi_{cs}$):** Cross-correlation between central and satellite galaxies.
2. **Satellite-Satellite ($\xi_{ss}$):** Auto-correlation of satellite galaxies.

To ensure robust pair counting with periodic boundary conditions, we use `scipy.spatial.cKDTree` with `boxsize=500.0`. A uniform random catalog of $N_R = 300,000$ points (which is $>20\times$ larger than the data catalog of $\sim 12,000$ galaxies) is generated for each realization to compute the random pair counts ($RR$, $DR_c$, $DR_s$). 

The Landy-Szalay estimators used are:
- $\xi_{cs}(r) = \frac{DD_{cs} - DR_c - DR_s + RR}{RR}$
- $\xi_{ss}(r) = \frac{DD_{ss} - 2DR_s + RR}{RR}$
where all terms are normalized by their respective total possible pair counts.

To validate that the clustering signal is driven by the radial profile rather than halo-halo clustering, the exact same 2PCF components are computed for the **null model** (where satellite positions are shuffled uniformly within their host halos, generated in Step 3). Finally, the code aggregates the results across all 10 realizations, computes the full covariance matrices for all 2PCF components, and saves the results to disk.

**Python Code:**

```python
import sys
import os
sys.path.insert(0, os.path.abspath("codebase"))
import numpy as np
from scipy.spatial import cKDTree

def get_pair_counts(tree1, tree2, r_bins, is_auto=False):
    """
    Computes the number of pairs between two KD-Trees within specified radial bins.
    If is_auto=True, it corrects for self-pairs and double-counting.
    """
    counts_cum = tree1.count_neighbors(tree2, r_bins)
    counts_bin = counts_cum[1:] - counts_cum[:-1]
    if is_auto:
        # For auto-correlation, each unique pair is counted twice (i->j and j->i).
        # Self-pairs (d=0) are captured in counts_cum[0] if r_bins[0]=0, 
        # so counts_bin does not include self-pairs.
        counts_bin = counts_bin / 2.0
    return counts_bin

def compute_2pcf_optimized(pos_c, pos_s, pos_s_null, pos_r, r_bins, boxsize=500.0):
    """
    Computes the Landy-Szalay 2PCF for central-satellite and satellite-satellite pairs,
    for both the data and the null model, using a shared random catalog.
    """
    tree_c = cKDTree(pos_c, boxsize=boxsize)
    tree_s = cKDTree(pos_s, boxsize=boxsize)
    tree_s_null = cKDTree(pos_s_null, boxsize=boxsize)
    tree_r = cKDTree(pos_r, boxsize=boxsize)
    
    N_c = len(pos_c)
    N_s = len(pos_s)
    N_r = len(pos_r)
    
    # Normalization factors (using float to prevent any potential integer overflow)
    norm_cs = float(N_c) * float(N_s)
    norm_cr = float(N_c) * float(N_r)
    norm_sr = float(N_s) * float(N_r)
    norm_ss = float(N_s) * float(N_s - 1) / 2.0
    norm_rr = float(N_r) * float(N_r - 1) / 2.0
    
    # Random-Random pairs
    R_R = get_pair_counts(tree_r, tree_r, r_bins, is_auto=True)
    RR_norm = R_R / norm_rr
    RR_norm_safe = np.maximum(RR_norm, 1e-15) # Prevent division by zero
    
    # Central-Random pairs
    D_c_R = get_pair_counts(tree_c, tree_r, r_bins, is_auto=False)
    DR_c_norm = D_c_R / norm_cr
    
    # Data Satellites pairs
    D_c_D_s = get_pair_counts(tree_c, tree_s, r_bins, is_auto=False)
    D_s_R = get_pair_counts(tree_s, tree_r, r_bins, is_auto=False)
    D_s_D_s = get_pair_counts(tree_s, tree_s, r_bins, is_auto=True)
    
    DD_cs_norm = D_c_D_s / norm_cs
    DR_s_norm = D_s_R / norm_sr
    DD_ss_norm = D_s_D_s / norm_ss
    
    # Landy-Szalay Estimators for Data
    xi_cs = (DD_cs_norm - DR_c_norm - DR_s_norm + RR_norm) / RR_norm_safe
    xi_ss = (DD_ss_norm - 2 * DR_s_norm + RR_norm) / RR_norm_safe
    
    # Null Satellites pairs
    D_c_D_s_null = get_pair_counts(tree_c, tree_s_null, r_bins, is_auto=False)
    D_s_R_null = get_pair_counts(tree_s_null, tree_r, r_bins, is_auto=False)
    D_s_D_s_null = get_pair_counts(tree_s_null, tree_s_null, r_bins, is_auto=True)
    
    DD_cs_norm_null = D_c_D_s_null / norm_cs
    DR_s_norm_null = D_s_R_null / norm_sr
    DD_ss_norm_null = D_s_D_s_null / norm_ss
    
    # Landy-Szalay Estimators for Null Model
    xi_cs_null = (DD_cs_norm_null - DR_c_norm - DR_s_norm_null + RR_norm) / RR_norm_safe
    xi_ss_null = (DD_ss_norm_null - 2 * DR_s_norm_null + RR_norm) / RR_norm_safe
    
    # Handle bins where RR == 0
    invalid = RR_norm == 0
    xi_cs[invalid] = np.nan
    xi_ss[invalid] = np.nan
    xi_cs_null[invalid] = np.nan
    xi_ss_null[invalid] = np.nan
    
    return xi_cs, xi_ss, xi_cs_null, xi_ss_null

def main():
    data_dir = "data/"
    
    # Define radial bins for the 1-halo regime (0 to 5 Mpc/h)
    r_bins = np.linspace(0, 5, 26)
    r_bin_centers = 0.5 * (r_bins[:-1] + r_bins[1:])
    n_bins = len(r_bin_centers)
    
    all_xi_cs = np.zeros((10, n_bins))
    all_xi_ss = np.zeros((10, n_bins))
    all_xi_cs_null = np.zeros((10, n_bins))
    all_xi_ss_null = np.zeros((10, n_bins))
    
    # Random catalog size (> 10x the data size)
    N_r = 300000
    
    print("Computing 1-halo regime 2PCF (r < 5 Mpc/h) for data and null models...\n")
    
    for i in range(10):
        # Load matched catalog
        gal_path = os.path.join(data_dir, "matched_catalog_" + str(i).zfill(2) + ".npz")
        data = np.load(gal_path)
        galaxies = data['galaxies']
        
        is_central = galaxies[:, 8] == 1
        pos_c = galaxies[is_central, :3]
        pos_s = galaxies[~is_central, :3]
        
        # Load null catalog (shuffled satellites)
        null_path = os.path.join(data_dir, "null_catalog_" + str(i).zfill(2) + ".npy")
        null_galaxies = np.load(null_path)
        pos_s_null = null_galaxies[~is_central, :3]
        
        # Generate uniform random catalog
        np.random.seed(100 + i)
        pos_r = np.random.uniform(0, 500.0, (N_r, 3))
        
        # Compute 2PCF components
        xi_cs, xi_ss, xi_cs_null, xi_ss_null = compute_2pcf_optimized(
            pos_c, pos_s, pos_s_null, pos_r, r_bins, boxsize=500.0
        )
        
        all_xi_cs[i] = xi_cs
        all_xi_ss[i] = xi_ss
        all_xi_cs_null[i] = xi_cs_null
        all_xi_ss_null[i] = xi_ss_null
        
        print("Realization " + str(i).zfill(2) + " completed.")
        
    # Handle potential NaNs before covariance computation
    if np.isnan(all_xi_cs).any() or np.isnan(all_xi_ss).any():
        print("\nWarning: NaN values encountered in 2PCF (likely due to RR=0). Filling with 0 for covariance computation.")
        all_xi_cs = np.nan_to_num(all_xi_cs)
        all_xi_ss = np.nan_to_num(all_xi_ss)
        all_xi_cs_null = np.nan_to_num(all_xi_cs_null)
        all_xi_ss_null = np.nan_to_num(all_xi_ss_null)
        
    # Compute covariance matrices across the 10 realizations
    cov_xi_cs = np.cov(all_xi_cs, rowvar=False)
    cov_xi_ss = np.cov(all_xi_ss, rowvar=False)
    cov_xi_cs_null = np.cov(all_xi_cs_null, rowvar=False)
    cov_xi_ss_null = np.cov(all_xi_ss_null, rowvar=False)
    
    # Save results
    out_path = os.path.join(data_dir, "2pcf_1halo.npz")
    np.savez(out_path, 
             r_bins=r_bins, 
             r_bin_centers=r_bin_centers,
             xi_cs=all_xi_cs, 
             xi_ss=all_xi_ss,
             xi_cs_null=all_xi_cs_null, 
             xi_ss_null=all_xi_ss_null,
             cov_xi_cs=cov_xi_cs,
             cov_xi_ss=cov_xi_ss,
             cov_xi_cs_null=cov_xi_cs_null,
             cov_xi_ss_null=cov_xi_ss_null)
             
    print("\nSaved 2PCF components and covariance matrices to " + out_path)
    
    # Print summary statistics for the researcher
    mean_xi_cs = np.mean(all_xi_cs, axis=0)
    mean_xi_ss = np.mean(all_xi_ss, axis=0)
    mean_xi_cs_null = np.mean(all_xi_cs_null, axis=0)
    mean_xi_ss_null = np.mean(all_xi_ss_null, axis=0)
    
    print("\nSummary of Mean 2PCF (first 5 bins):")
    print("r_centers (Mpc/h):               " + str(np.round(r_bin_centers[:5], 3)))
    print("Data Central-Satellite xi_cs:    " + str(np.round(mean_xi_cs[:5], 2)))
    print("Data Satellite-Satellite xi_ss:  " + str(np.round(mean_xi_ss[:5], 2)))
    print("Null Central-Satellite xi_cs:    " + str(np.round(mean_xi_cs_null[:5], 2)))
    print("Null Satellite-Satellite xi_ss:  " + str(np.round(mean_xi_ss_null[:5], 2)))
    
    print("\nVariance (diagonal of covariance matrix) for first 5 bins:")
    print("Var Data xi_cs:                  " + str(np.round(np.diag(cov_xi_cs)[:5], 2)))
    print("Var Data xi_ss:                  " + str(np.round(np.diag(cov_xi_ss)[:5], 2)))

if __name__ == '__main__':
    main()
