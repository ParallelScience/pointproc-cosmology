        model_density = mean_N_sat * prob_bin / V_shell_x
        ax.plot(x_bin_centers, model_density, 'r-', label="Exp Fit (lambda=" + str(np.round(lam, 3)) + ")")
        ax.set_yscale('log')
        ax.set_xlabel('x = r/R_vir')
        ax.set_ylabel('Normalized Density n(x)')
